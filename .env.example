# ---------------------------------------------------------------------------
# VeriAge : variables d'environnement (copier en .env, ne jamais committer .env)
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_NAME=VeriAge
# local | testing | production
APP_ENV=production
# N'est pris en compte que si APP_ENV n'est pas "production".
APP_DEBUG=false
# Domaine racine, jamais écrit en dur dans le code.
APP_DOMAIN=veriage.eu
# URL publique du site (vitrine + espace client), sans barre finale.
APP_URL=https://www.${APP_DOMAIN}
# Module de vérification (API, page hébergée /s/{session}, widget) : sous-domaine « verify. ».
VERIFY_URL=https://verify.${APP_DOMAIN}
# Démonstration « plateforme cliente fictive » (/demo). Désactivée en production sauf DEMO_ENABLED=true.
DEMO_URL=
DEMO_ENABLED=false
# Clé sandbox et secret de signature du projet de démonstration : php bin/project.php demo
DEMO_API_KEY=
DEMO_SIGNING_SECRET=
APP_TIMEZONE=Europe/Brussels

# Clé applicative (HMAC : clés de rate limiting, poivre des hash d'e-mail).
# 32 octets aléatoires encodés en base64 : php bin/generate-keys.php
APP_KEY=
# Clé de chiffrement des données (AES-256-GCM, e-mails chiffrés). 32 octets en base64.
CRYPTO_KEY=

# --- Langues ----------------------------------------------------------------
# Langues servies (les 24 dossiers lang/ existent, seules celles-ci sont exposées).
LANGS_ENABLED=fr,en
# Langue de repli quand une clé manque (et langue par défaut).
LANG_FALLBACK=en

# --- Base de données (MariaDB) ---------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veriage
DB_USERNAME=veriage
DB_PASSWORD=

# --- Redis (sessions, rate limiting, files) --------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=veriage:

# --- Sessions ----------------------------------------------------------------
# Inactivité maximale (minutes) avant expiration de la session.
SESSION_IDLE_MINUTES=30
# Durée de vie absolue (minutes) d'une session, même active.
SESSION_ABSOLUTE_MINUTES=720
# Cookie "Secure" (préfixe __Host-). À laisser à true hors développement local en HTTP.
SESSION_SECURE_COOKIE=true

# --- Sécurité ----------------------------------------------------------------
HSTS_MAX_AGE=31536000
# N'activer que si TOUS les sous-domaines de APP_DOMAIN sont en HTTPS (jamais sur un domaine partagé).
HSTS_INCLUDE_SUBDOMAINS=false
# Proxys inverses de confiance (IP ou CIDR, séparés par des virgules) : leur X-Forwarded-For est cru.
# Laisser vide sous HestiaCP si Apache restaure l'IP réelle (mod_remoteip) ; sinon ex. 127.0.0.1
TRUSTED_PROXIES=
# Coût Argon2id (mémoire en Kio, itérations, parallélisme).
PASSWORD_ARGON2_MEMORY=65536
PASSWORD_ARGON2_TIME=4
PASSWORD_ARGON2_THREADS=1

# --- E-mail ------------------------------------------------------------------
# smtp | log ("log" écrit les messages MIME dans MAIL_OUTBOX ; interdit en production)
MAIL_DRIVER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
# tls (STARTTLS) | ssl (TLS implicite) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@${APP_DOMAIN}
MAIL_FROM_NAME=${APP_NAME}
# Dossier de la boîte d'envoi de développement (driver "log").
MAIL_OUTBOX=storage/mail
# redis : file chiffrée + worker (bin/worker.php, relances) ; sync : envoi après la réponse (dev sans worker).
MAIL_QUEUE=redis

# --- Module de vérification ----------------------------------------------------
# Échecs tolérés par adresse e-mail (24 h glissantes, par projet) avant blocage.
VERIFICATION_MAX_FAILURES=5
# DÉVELOPPEMENT UNIQUEMENT : autorise http:// et les adresses privées/locales pour les webhooks et
# return_url (démo locale). Ignoré et refusé en production.
VERIFICATION_ALLOW_PRIVATE_NETWORK=false
# Rétention du journal d'audit (jours).
AUDIT_RETENTION_DAYS=365

# --- Journaux ----------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
# Rétention des journaux (jours) : un fichier par jour, les plus anciens sont supprimés automatiquement.
LOG_RETENTION_DAYS=30
